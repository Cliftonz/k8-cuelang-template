package home

let C = cluster

// ClusterExternalSecret — auto-provisions GHCR pull secrets into all preview-* namespaces.
// Uses External Secrets Operator to distribute registry credentials from OpenBao.
clusterExternalSecrets: [
	// GHCR pull credentials — imagePullSecrets for pulling container images
	// into every preview-* namespace. Reads from `preview/ghcr-pat` (a
	// classic PAT with `read:packages` scope) NOT `preview/github-pat`
	// (the fine-grained PAT used for ApplicationSet pullRequest generator
	// auth). Fine-grained PATs do not expose `packages:` scopes, so the
	// fine-grained PAT cannot pull private GHCR images. The bb-docs
	// ExternalSecret in externalsecrets.cue uses the same `preview/ghcr-pat`
	// path — keep them in sync.
	{
		name:    "ghcr-pull-secret"
		cluster: C.name
		owner:   "platform-team"
		config: {
			namespaceSelector: matchLabels: preview: "true"
			externalSecretSpec: {
				refreshInterval: "5m"
				secretStoreRef: {
					name: "openbao-backend"
					kind: "ClusterSecretStore"
				}
				target: {
					name: "ghcr-pull-secret"
					template: {
						type: "kubernetes.io/dockerconfigjson"
						data: ".dockerconfigjson": #"""
{"auths":{"ghcr.io":{"auth":"{{ printf "%s:%s" .username .token | b64enc }}"}}}
"""#
					}
				}
				data: [
					{secretKey: "username", remoteRef: {key: "preview/ghcr-pat", property: "GHCR_USER"}},
					{secretKey: "token", remoteRef: {key: "preview/ghcr-pat", property: "GHCR_TOKEN"}},
				]
			}
		}
	},

	// Shared app secrets — environment variables that are the SAME across
	// all preview environments. Automatically provisioned into every
	// preview-pr-{N} namespace by the namespaceSelector.
	//
	// The preview Helm chart mounts this Secret as envFrom on the app
	// Deployment, so every key in this Secret becomes an env var.
	//
	// Add new shared secrets by writing them to OpenBao at the paths below.
	// ESO syncs within 1h (or restart ESO to force immediate sync).
	//
	// Examples of what goes here:
	//   - Third-party API keys (Vercel AI Gateway, Stripe test, SendGrid)
	//   - NEXTAUTH_SECRET (same signing key across all previews)
	//   - Feature flag service tokens
	//   - Shared webhook URLs or callback base URLs
	//
	// Examples of what does NOT go here (per-preview, see docs):
	//   - DATABASE_URL (unique per PR — generated by Helm chart)
	//   - REDIS_URL (unique per PR)
	//   - Preview-specific callback URLs with the PR number in them
	{
		name:    "app-shared-secrets"
		cluster: C.name
		owner:   "platform-team"
		config: {
			namespaceSelector: matchLabels: preview: "true"
			externalSecretSpec: {
				refreshInterval: "5m"
				secretStoreRef: {
					name: "openbao-backend"
					kind: "ClusterSecretStore"
				}
				target: {
					name:           "app-shared-secrets"
					creationPolicy: "Owner"
				}
				data: [
					// Auth
					{secretKey: "NEXTAUTH_SECRET", remoteRef: {key: "preview/app/nextauth-secret", property: "NEXTAUTH_SECRET"}},

					// AI / LLM — Vercel AI SDK has the gateway URL baked in, so
					// only the auth key is needed here.
					{secretKey: "VERCEL_AI_GATEWAY_KEY", remoteRef: {key: "preview/app/vercel-ai-gateway-key", property: "VERCEL_AI_GATEWAY_KEY"}},

					// Email / Notifications — each preview env runs mailpit in-namespace
					// on mailpit.preview-pr-{N}.svc.cluster.local:1025, no shared secret.

					// Payments
					{secretKey: "STRIPE_SECRET_KEY", remoteRef: {key: "preview/app/stripe-secret-key", property: "STRIPE_SECRET_KEY"}},
					{secretKey: "STRIPE_WEBHOOK_SECRET", remoteRef: {key: "preview/app/stripe-webhook-secret", property: "STRIPE_WEBHOOK_SECRET"}},
					// STRIPE_API_KEY drives the chart's stripe-listen sidecar
					// (chart ≥0.3.2). The sidecar runs `stripe listen` against
					// Stripe's CLI websocket to forward test-mode webhooks at
					// `<release>-salessage:3000/api/webhooks/stripe`. Use a
					// test-mode restricted key (rk_test_…) with read on
					// Customers/Charges/Subscriptions/PaymentIntents/Events/
					// WebhookEndpoints + write on WebhookEndpoints (the CLI
					// registers a temporary endpoint per session). One shared
					// rk_test_ key serves every preview env — test data is
					// shared anyway, no isolation benefit from per-PR keys.
					//
					// OpenBao path is `stripe-cli-key` (purpose-descriptive),
					// distinct from `stripe-secret-key` (sk_test_… used by the
					// app for charges) and `stripe-webhook-secret` (legacy /
					// ignored by stripe-listen — that Pod mints its own webhook
					// secret per session). The Secret data field surfaces as
					// `STRIPE_API_KEY` because that's the env var the sidecar
					// (and the upstream `stripe listen` CLI) reads.
					{secretKey: "STRIPE_API_KEY", remoteRef: {key: "preview/app/stripe-cli-key", property: "STRIPE_API_KEY"}},

					// Supabase — historical shared-instance fields. As of the
					// full-Supabase-per-preview migration these placeholder
					// values are NOT consumed by the app at runtime; the
					// per-preview chart's jwt-init Job derives the real
					// JWT_SECRET / anon / service-role keys deterministically
					// from JWT_MASTER_KEY (below) and writes them to a
					// per-namespace Secret the app reads via secretKeyRef.
					// These three keys are kept for backward compatibility
					// with the chart's initContainer that sed-substitutes
					// NEXT_PUBLIC_* placeholders into the baked Next.js bundle.
					// Once the chart fully consumes per-preview Supabase, the
					// SUPABASE_SECRET_KEY entry here can be dropped.
					{secretKey: "SUPABASE_SECRET_KEY", remoteRef: {key: "preview/app/supabase-secret-key", property: "SUPABASE_SECRET_KEY"}},
					{secretKey: "NEXT_PUBLIC_SUPABASE_URL", remoteRef: {key: "preview/app/supabase-url", property: "NEXT_PUBLIC_SUPABASE_URL"}},
					{secretKey: "NEXT_PUBLIC_SUPABASE_PUBLIC_KEY", remoteRef: {key: "preview/app/supabase-anon-key", property: "NEXT_PUBLIC_SUPABASE_PUBLIC_KEY"}},

					// Per-preview Supabase JWT master key — HMAC seed used by
					// the chart's jwt-init Job to derive deterministic
					// {jwt_secret, anon_key, service_role_key} for each
					// preview namespace. Same secret across rebuilds (so
					// auth tokens survive a pod restart), distinct across
					// previews (no token portability between PRs).
					//
					// Operator runbook (one-time seed):
					//   bao kv put -mount=secret preview/app/supabase-jwt-master \
					//     JWT_MASTER_KEY="$(openssl rand -hex 32)"
					//
					// Rotate by overwriting the master then deleting each
					// per-namespace Secret (`<release>-supabase-jwt`) so the
					// jwt-init Job re-runs. Forces user sign-out across all
					// preview environments.
					{secretKey: "JWT_MASTER_KEY", remoteRef: {key: "preview/app/supabase-jwt-master", property: "JWT_MASTER_KEY"}},
				]
			}
		}
	},
]
