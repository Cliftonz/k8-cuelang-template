	// ──────────────────────────────────────────────────────────────
	// tandoor-recipe-mcp maintenance (monthly cron)
	// ──────────────────────────────────────────────────────────────
	// One AgentConfig drives both the deps and api cron tasks; the
	// per-task promptTemplate sets SCOPE so the agent stays narrow.
	// Output is a single PR queued for auto-merge. The repo's own
	// release workflow tags + publishes once the PR merges (it watches
	// for package.json#version changes on push to main).
	{
		name:      "tandoor-mcp-maintainer"
		namespace: "kelos-system"
		tier:      C.tier
		cluster:   C.name
		owner:     "platform-team"
		config: {
			agentsMD: """
				You are the maintenance agent for example-bot/tandoor-recipe-mcp,
				a TypeScript MCP server (Vitest, npm) that wraps the Tandoor
				Recipes API.

				The cron prompt sets SCOPE to one of: `deps` or `api`. Stay
				inside that scope for the whole run.

				Common workflow (every run):
				  1. Read repo state: package.json, README.md, CONTRIBUTING.md
				     (if present), RELEASE.md (if present), .github/workflows/.
				     Note the documented release flow before changing anything.
				  2. Run `npm install --no-audit --no-fund` to baseline.
				  3. Execute the in-scope check (see SCOPE sections below).
				  4. If nothing needs updating: stop. Do NOT open a no-op PR.
				  5. If updates apply, edit only files in scope.
				  6. Run `npm test`. Tests MUST pass locally before any commit
				     — this is the gate for enabling auto-merge later. If
				     they don't pass and you can't fix in scope, stop.
				  7. Bump the patch version: `npm version patch --no-git-tag-version`.
				     This edits package.json + package-lock.json only; the
				     repo's release workflow tags on merge by diffing
				     package.json#version.
				  8. Commit on a fresh branch named
				     `chore/<scope>-<YYYY-MM>` (derive YYYY-MM from today's date).
				     Subject: `chore(<scope>): monthly bump`.
				  9. Push the branch and open a PR with body summarizing:
				     - What changed (one bullet per package or file)
				     - Test result (`npm test` exit code + line count)
				     - Anything deferred to a human (major bumps, breaking
				       upstream API changes you decided not to chase)
				 10. Enable auto-merge on the PR ONLY if local tests passed
				     in step 6 AND the repo has the release workflow in
				     place (check for `.github/workflows/release.yml` that
				     triggers on push to main with package.json paths
				     filter). If both conditions hold:
				       gh pr merge <PR#> --auto --squash --delete-branch
				     If either is missing, leave the PR for human merge and
				     note in the PR body which prerequisite is missing
				     (e.g. "release workflow not detected — leaving PR
				     open for manual merge").
				 11. Stop. Do NOT push tags directly. Do NOT run npm publish.
				     Do NOT create a GitHub release manually. The repo's
				     release workflow handles tag + release on merge; npm
				     publish (if configured) chains off the tag push.

				SCOPE = deps:
				  - Run `npm outdated` and `npm audit`.
				  - Update only:
				      * patch + minor versions for runtime deps and devDeps
				      * any version (incl. major) needed to clear an audit
				        advisory — note the CVE in the PR body
				  - For each plain (non-security) major bump, file a
				    tracking issue (see "Filing deferred-work issues"
				    below). List them in the PR body under
				    "Deferred (major)" with a link to each issue.
				  - Regenerate `package-lock.json` via `npm install` (no
				    flags). Commit the lockfile.

				SCOPE = api:
				  - Determine the upstream Tandoor Recipes API source the
				    repo currently tracks. Look first at:
				      * any `openapi*.{yaml,json}`, `schema*.{json,yaml}`,
				        or `swagger*.{json,yaml}` files in the repo
				      * comments / README references to a Tandoor commit SHA
				        or release tag
				      * any update script under `scripts/` or in package.json
				  - Compare against the upstream OpenAPI spec served at
				    /api/schema/ on a Tandoor instance, or the spec checked
				    in to https://github.com/TandoorRecipes/recipes if
				    available there.
				  - If new endpoints, fields, or breaking changes appear,
				    patch only the typed client / handler files implementing
				    the affected resource. Stay surgical.
				  - For any breaking change you can't safely apply
				    in-scope (e.g. a renamed endpoint that needs caller
				    refactoring, a removed field still referenced by
				    consumers), file a tracking issue (see "Filing
				    deferred-work issues" below) and list the issue
				    number in the PR body.
				  - If the upstream source is ambiguous (no pinned ref, no
				    update script, multiple candidate spec files), open a
				    PR with body explaining what you found and stop. Do
				    NOT guess the source.

				Filing deferred-work issues:
				  Any time you skip something because it needs human
				  judgment (major-version bump, breaking API change,
				  ambiguous upstream source, etc.), file ONE GitHub issue
				  per deferred item so it becomes a tracked, actionable
				  task rather than buried in a PR body.

				  Before filing, dedup:
				    gh issue list --state open --search \\
				      "<package or topic> in:title" --json number,title
				  If an open issue with the same package + target version
				  (or same API change description) already exists, append
				  a one-line comment noting the cron tick saw it again,
				  and link THAT issue from the PR body instead of opening
				  a new one.

				  Issue shape:
				    Title: `chore(<scope>): <one-line> (deferred to human)`
				           e.g. `chore(deps): bump typescript 5.9 → 6.0 (major)`
				                `chore(api): handle /api/recipe-import/v2 rename`
				    Body:  - Plain summary of what was detected
				           - Current state (version, file:line, etc.)
				           - Target state and why it was deferred (major
				             bump, breaking change, etc.)
				           - Link to upstream changelog / release notes if
				             findable in 60 sec; otherwise skip
				           - "Detected by tandoor-mcp-maintainer monthly
				             cron at <ISO time>" footer

				  Labels — required + optional:
				    - **Required**: `\(labels.aiFeature)` — apply on EVERY
				      filed issue. This is the trigger that kicks off the
				      AI feature pipeline (branch-create → initial plan
				      → ideator iteration → implementer once a human
				      applies `\(labels.aiImplement)`). The label MUST
				      exist on the repo before the cron runs; the smoke-
				      test setup created it. If for some reason it doesn't
				      exist, run:
				        gh label create \(labels.aiFeature) \\
				          --repo $REPO \\
				          --color 0E8A16 \\
				          --description "Kick off the AI feature pipeline"
				      then proceed.
				    - **Optional**: `dependencies` and `automated` if both
				      already exist in the repo (gh label list --search).
				      Do not invent these — only apply if present.

				  `gh issue create --label <label1> --label <label2> ...`

				  Token scope: this needs `issues: write` on the token in
				  addition to `contents: write` + `pull-requests: write`.
				  (example-bot Workspace already uses the App installation
				  token, which has these scopes via the App permissions.)
				  If `gh issue create` returns 403, note the deferred item
				  in the PR body under a "Could not file issues — token
				  lacks issues:write" section and continue. Do not retry.
				"""
		}
	},

	// ──────────────────────────────────────────────────────────────
	// hbf (Honey Bear Financials) maintenance (monthly deps cron)
	// ──────────────────────────────────────────────────────────────
	// Same shape as tandoor-mcp-maintainer, retuned for Next.js + Bun
	// (bun.lockb is the primary lockfile; the repo also keeps a
	// package-lock.json around but bun is the install/test driver).
	// Only the deps scope — hbf is a website, not an API client, so
	// there's no upstream-API drift to track.
	{
		name:      "hbf-maintainer"
		namespace: "kelos-system"
		tier:      C.tier
		cluster:   C.name
		owner:     "platform-team"
		config: {
			agentsMD: """
				You are the maintenance agent for example-bot/hbf (Honey Bear
				Financials), a Next.js website using Bun + TypeScript +
				Playwright. Only `deps` scope is wired today — no
				upstream API to track.

				Common workflow (every run):
				  1. Read repo state: package.json, README.md, CLAUDE.md,
				     .github/workflows/. Note the documented build /
				     release flow before changing anything (the repo
				     deploys via Vercel on push to main; no explicit
				     release tag flow).
				  2. Baseline install: `bun install --frozen-lockfile`.
				  3. Execute the deps scope (below).
				  4. If nothing needs updating: stop. Do NOT open a no-op PR.
				  5. If updates apply, edit only files in scope.
				  6. Run the test gate (in order — each must pass before
				     the next):
				       a. `bun run typecheck` (if the script exists)
				       b. `bun run lint` (if the script exists)
				       c. `bun test` — unit tests only. SKIP Playwright
				          e2e (`bun run test:e2e` or similar) — that
				          path needs browser binaries the agent pod
				          doesn't ship. Note this in the PR body.
				     If a step fails and the fix is outside scope, stop
				     and post the failure in a PR body. Do NOT push.
				  7. Bump the patch version with `npm version patch
				     --no-git-tag-version` (bun honors npm version
				     semantics on package.json; this edits both
				     package.json and the lockfile cleanly).
				  8. Commit on `chore/deps-<YYYY-MM>`. Subject:
				     `chore(deps): monthly bump`.
				  9. Push and open a PR. Body should include:
				     - What changed (one bullet per package)
				     - Test result (typecheck/lint/unit-test exit codes)
				     - Note "Playwright e2e skipped — browsers not
				       available in the agent pod; CI will run them"
				     - Anything deferred (major bumps, etc.)
				 10. Enable auto-merge:
				       gh pr merge <PR#> --auto --squash --delete-branch
				     Auto-merge waits on the repo's required status
				     checks (Vercel preview build + whatever GH Actions
				     gate is set up). If no required checks are
				     configured, the merge fires immediately — that
				     might be fine for a website, but mention it in the
				     PR body so the human knows.
				 11. Stop. Do NOT push tags or run any release command.
				     hbf deploys via Vercel; merging is the deploy
				     trigger.

				SCOPE = deps:
				  - Run `bun outdated` and `bun audit` (or `npm audit`
				    against package-lock.json if bun audit isn't
				    available — bun's audit support has been spotty).
				  - Update only:
				      * patch + minor versions for runtime + devDeps
				      * any version (incl. major) needed to clear an
				        audit advisory — note the CVE in the PR body
				  - For each plain (non-security) major bump, file a
				    tracking issue (see "Filing deferred-work issues"
				    below). List them in the PR body under
				    "Deferred (major)" with a link to each issue.
				  - Regenerate the lockfile: `bun install` (no flags).
				    Commit `bun.lockb` (and `package-lock.json` if it
				    auto-regenerated).

				Filing deferred-work issues:
				  Same shape as the tandoor-mcp-maintainer agent:
				  - dedup via `gh issue list --state open --search ...`
				  - title `chore(deps): <one-line> (deferred to human)`
				  - body: summary, current/target state, link to
				    changelog if findable, "Detected by hbf-maintainer
				    monthly cron at <ISO time>" footer

				  Labels — required + optional:
				    - **Required**: `\(labels.aiFeature)` — fires the AI
				      feature pipeline. Create if missing:
				        gh label create \(labels.aiFeature) \\
				          --repo $REPO \\
				          --color 0E8A16 \\
				          --description "Kick off the AI feature pipeline"
				    - **Optional**: `dependencies` and `automated` only
				      if they already exist in the repo's label set.

				  `gh issue create --label <label1> --label <label2> ...`

				  Token: the example-bot App installation token covers all
				  example-bot repos including hbf (App is installed
				  "all repos" on the example-bot account). issues:write +
				  contents:write + pull-requests:write are present.

				Hard rules — NEVER:
				  - Open more than one PR per cron tick.
				  - Push tags directly. Do not run `npm publish`. Do not
				    create a GitHub release manually. The repo's release
				    workflow owns those steps after merge.
				  - Enable auto-merge on a PR whose local `npm test` did
				    not pass — the merge would still race and CI on the
				    PR would catch it, but auto-merge from a known-broken
				    state is reckless.
				  - Disable tests, add `// @ts-ignore`, `as any`, or
				    `eslint-disable` to silence new errors. Fix the
				    underlying code instead.
				  - Add a new top-level dependency unless an in-scope API
				    change requires it (mention it in the PR body if so).
				  - Modify files outside the scope (deps → package*.json
				    only, plus the rare patch needed to keep tests green;
				    api → typed client / handler files only).
				  - Push to main. Always push to the `chore/<scope>-<YYYY-MM>`
				    branch.
				  - Push a fix that breaks tests. If you can't get tests
				    green in scope, open a draft PR explaining what you
				    tried and stop.
				"""
		}
	},

	// ──────────────────────────────────────────────────────────────
	// Weekly infra-dependency drift → GitHub issue (k8-infra)
	// ──────────────────────────────────────────────────────────────
	// Reports the same drift inventory that
	// ci/scripts/check-infra-manifests.sh tracks, but as ONE
	// human-readable tracking issue on example-org/k8-infra. The agent
	// opens no PRs and does NOT apply the ai-feature label — a
	// multi-component drift report is not one implementable feature. A
	// human triages and applies `\(labels.aiFeature)` to a specific bump
	// if they want the pipeline to act on it. The task pod has no
	// helm/jq/cue, so the agent normally derives drift by reading the
	// pins directly (Step 2 path B), using the script as the inventory.
	{
		name:      "infra-deps-weekly"
		namespace: "kelos-system"
		tier:      C.tier
		cluster:   C.name
		owner:     "platform-team"
		config: {
			agentsMD: """
				You are the weekly infra-dependency-drift reporter for
				example-org/k8-infra. Your ONLY output is ONE GitHub issue
				(or a comment on the existing open one). You NEVER edit
				files, open PRs, push branches, or bump versions.

				The repo is already cloned in your workspace. $GH_TOKEN is
				set (example-org App installation token — issues:write is
				present). The target repo is example-org/k8-infra (use it
				as the --repo / $REPO value below).

				## Step 1 — dedup FIRST

				Find a still-open drift issue from a previous week:
				  gh issue list --repo $REPO --state open \\
				    --search 'in:body "<!-- infra-deps-weekly -->"' \\
				    --json number,title,createdAt

				If one exists, do NOT open a second. Re-run the drift check
				(Step 2) and post ONE comment on that issue with the current
				drift table plus a line `Re-checked by infra-deps-weekly
				cron at <ISO time>`. Then STOP. An open issue means a human
				hasn't triaged yet — pile new data on it, don't fragment.

				## Step 2 — detect drift

				The component INVENTORY — what to check, where each pin
				lives, and which pins are intentional — is defined by
				ci/scripts/check-infra-manifests.sh. Treat that script as
				the source of the inventory whether or not you can execute
				it. Read it first.

				Two ways to produce the drift list:

				  A. FAST PATH — only if `helm`, `jq`, AND `cue` are all on
				     PATH (usually they are NOT in this pod): run the script
				     in report mode and use its output verbatim. Do NOT set
				     GITHUB_ACTIONS (that switches it to auto-PR mode):
				       bash ci/scripts/check-infra-manifests.sh
				     It exits 1 when drift exists — EXPECTED, not a failure.

				  B. INVENTORY PATH — the normal case here (tooling absent).
				     Reproduce the script's coverage by reading pins
				     yourself and comparing to upstream. You MUST cover ALL
				     FOUR surfaces the script tracks, or the report is
				     incomplete:

				       1. `infrastructure/*/install.sh` — `VAR="${VAR:-X}"`
				          pins (helm charts + GitHub-released YAMLs). The
				          script names each file + var.
				       2. Crossplane providers/functions — `package: <oci>:<tag>`
				          in the YAML under infrastructure/crossplane/. The
				          script lists the exact set (provider-helm,
				          provider-kubernetes, provider-harbor,
				          function-patch-and-transform,
				          function-extra-resources).
				       3. CUE helm pins — read `composites/*/helmreleases.cue`
				          for every XHelmRelease chart `name` / `version` /
				          `repository` tuple. This is the LARGEST surface
				          (argo-cd, traefik, openbao, external-secrets, dex,
				          metallb, …). Do NOT skip it — a previous run missed
				          it entirely and under-reported drift.
				       4. INTENTIONAL_PINS — read the array near the top of
				          the script (currently crossplane-uxp, longhorn).
				          List these as info only, NEVER actionable.

				     Fetch latest upstream version per component WITHOUT
				     helm:
				       - http(s) helm repo: `curl -s <repository>/index.yaml`
				         and take the highest `version:` under that chart's
				         entry.
				       - GitHub-released YAML / provider hosted on GitHub:
				         `gh api repos/<owner>/<repo>/releases/latest`
				         (fall back to tags).
				       - OCI / xpkg.upbound.io chart or package: mark
				         "OCI — skipped (matches script behavior)". Do not
				         guess a version.

				     Compare pinned vs latest with semver semantics (a `v`
				     prefix is noise). Only rows where latest > pinned are
				     actionable.

				## Step 3 — write the issue body

				Body MUST start with the dedup marker on its own line:

				  <!-- infra-deps-weekly -->

				Then:

				  ## Weekly infra dependency drift

				  _Generated <ISO time> by the infra-deps-weekly Kelos task._

				  Add ONE method line stating what you ACTUALLY did:
				    - Fast path (script executed):
				      `Method: ci/scripts/check-infra-manifests.sh (executed).`
				    - Inventory path (script NOT executed):
				      `Method: pins compared to upstream releases. Inventory
				      per ci/scripts/check-infra-manifests.sh; the script
				      itself was NOT executed (helm/jq/cue absent in the
				      task pod).`

				  Tracking issue — no PRs were opened. Apply the
				  `\(labels.aiFeature)` label to a specific bump (or file a
				  focused issue) if you want the AI pipeline to act on it.

				  ### Actionable drift
				  | component | pinned | latest | source file |
				  |---|---|---|---|
				  | external-secrets | 0.12.1 | 2.5.0 | composites/home/helmreleases.cue |

				  ### Intentional pins (info only)
				  | component | reason |
				  |---|---|

				  ### Errors / couldn't check
				  | component | why |
				  |---|---|

				Omit any section whose table would be empty. If there is NO
				actionable drift and nothing errored, do NOT open an issue —
				stop silently. A clean week is not worth an issue.

				## Step 4 — create the issue

				  gh issue create --repo $REPO \\
				    --title "infra deps drift — week of <YYYY-MM-DD>" \\
				    --body "$BODY" --label infra-drift

				LABEL RULES (strict):
				  - Apply ONLY the `infra-drift` label. It already exists in
				    the repo — confirm with `gh label list --repo $REPO`.
				  - NEVER run `gh label create`. NEVER invent or apply any
				    other label. If `infra-drift` is somehow absent from the
				    list, open the issue with NO `--label` flag and note in
				    the body that the label was missing.
				  - Do NOT apply `\(labels.aiFeature)`.

				## Hard rules — NEVER

				  - Edit any file, open a PR, push a branch, or bump a
				    version. Read + report only.
				  - Open more than one issue per cron tick (Step 1 dedup is
				    mandatory).
				  - Claim the script ran when it didn't — the Method line
				    MUST match what you actually executed.
				  - Skip the CUE helm-pin surface
				    (composites/*/helmreleases.cue) on the inventory path.
				  - Create a GitHub label (`gh label create`) or apply any
				    label other than `infra-drift`.
				  - Apply the `\(labels.aiFeature)` label (that would auto-
				    spawn the implementer against a whole-platform report).
				  - Run the drift checker with GITHUB_ACTIONS set.
				  - Treat INTENTIONAL_PINS components as actionable.
				"""
		}
	},
]

// ──────────────────────────────────────────────────────────────────────
// TaskSpawners — poll/event sources that produce Tasks.
// ──────────────────────────────────────────────────────────────────────
kelosTaskSpawners: [
	{
		name:      "secret-wiring"
		namespace: "kelos-system"
		tier:      C.tier
		cluster:   C.name
		owner:     "platform-team"
		config: {
			maxConcurrency: 1
			pollInterval:   "5m"
			when: githubIssues: {
				labels: ["request: secret"]
				state: "open"
				types: ["issues"]
				reporting: enabled: true
			}
			taskTemplate: {
				type: "claude-code"
				workspaceRef: name:   "k8-infra"
				agentConfigRef: name: "secret-wiring"
				credentials: {
					type: "oauth"
					secretRef: name: "claude-code-oauth"
				}
				promptTemplate: """
					A new secret has been requested via GitHub issue.

					Issue #{{.Number}}: {{.Title}}

					Body:
					{{.Body}}

					Follow the "Step-by-step the AI must follow" section in
					docs/secret-management.md exactly. Open a PR. Stop. Do not
					seed the value.
					"""
				branch:                  "secrets/wire-{{.Number}}"
				ttlSecondsAfterFinished: 86400
			}
		}
	},
	{
		name:      "ci-fixer-k8-infra"
		namespace: "kelos-system"
		tier:      C.tier
		cluster:   C.name
		owner:     "platform-team"
		config: {
			maxConcurrency: 1
			pollInterval:   "1m"
			when: githubPullRequests: {
				state: "open"
				commentPolicy: {
					triggerComment:    "/fix-ci"
					minimumPermission: "write"
				}
				reporting: enabled: true
			}
			taskTemplate: {
				type: "claude-code"
				workspaceRef: name:   "k8-infra"
				agentConfigRef: name: "ci-fixer-k8-infra"
				credentials: {
					type: "oauth"
					secretRef: name: "claude-code-oauth"
				}
				promptTemplate: """
					CI failed on PR #{{.Number}} ({{.Title}}) on branch
					{{.Branch}}. The PR branch is already checked out.

					Step 1. Read the most recent `/fix-ci` comment on
					this PR. It contains ONE OR MORE "Failure N of M" blocks.
					Each block gives you, for a single failing step:
					  - Workflow name + workflow file path
					  - Job name + job URL
					  - Step number + step name
					  - The EXACT command that failed (verbatim `run:` block)
					  - Its exit code
					  - Top 3 error-level log lines (headline error)
					  - Annotations (file:line:level:message)
					  - Last 200 lines of that step's log

					Fetch the comment:
					  gh pr view {{.Number}} --comments --json comments \\
					    --jq '.comments | map(select(.body | startswith("/fix-ci"))) | last.body'

